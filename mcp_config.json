{
  "mcpServers": {
    "quran-companion": {
      "command": "sh",
      "args": [
        "-c",
        "exec python3 \"$HOME/.config/omarchy/plugins/szaidi.quran/mcp/server.py\""
      ]
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    }
  }
}
